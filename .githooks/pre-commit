#!/bin/bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Reject commits with mixed staged/unstaged changes.
mixed=$(comm -12 \
    <(git diff --cached --name-only | sort) \
    <(git diff --name-only | sort))
if [[ $mixed ]]; then
    echo "ERROR: Files have both staged and unstaged changes:" >&2
    echo "$mixed" >&2
    echo "Fix with: git add <file> OR git reset <file> OR git stash -k" >&2
    exit 1
fi

# Handle other unstaged/untracked changes.
has_changes() {
    ! git diff --quiet || git ls-files --others --exclude-standard | grep -q .
}

if has_changes; then
    git stash push -quk -m "pre-commit backup"
    trap 'git stash pop -q 2>/dev/null || {
        git stash apply -q 2>/dev/null || true
        git diff --check &>/dev/null || {
            git reset --hard -q
            echo "Conflicts detected. Your changes: git stash show -p stash@{0}" >&2
        }
    }' EXIT
fi

just pre-commit
